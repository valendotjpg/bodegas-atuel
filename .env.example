# Copiar a .env y completar. NUNCA subir .env al repo.
POSTGRES_DB=bodegas
POSTGRES_USER=bodegas_owner
POSTGRES_PASSWORD=cambiar_esta_clave
# Cambiar si ya hay un PostgreSQL instalado en la PC usando el 5432 (ej. 5433).
POSTGRES_PORT=5432

# Rol con privilegios minimos que usa la API (se crea en db/migrations/007_roles.sql)
API_DB_USER=bodegas_api
API_DB_PASSWORD=cambiar_esta_clave

# Rol de solo lectura para reportes (se crea en db/migrations/007_roles.sql)
REPORT_DB_USER=bodegas_report
REPORT_DB_PASSWORD=cambiar_esta_clave

# Tiene que coincidir con los valores de arriba (usuario, clave, puerto y base).
# Host "db" si la API corre dentro de docker compose; "localhost" si corre en la PC.
DATABASE_URL=postgresql://bodegas_owner:cambiar_esta_clave@localhost:5432/bodegas

# URL que usa la API local; dentro de Docker Compose se configura con el rol API.
API_DATABASE_URL=postgresql://bodegas_api:cambiar_esta_clave@localhost:5432/bodegas

# Puertos de la API y del front en la PC (opcionales).
API_PORT=8000
FRONT_PORT=8080
