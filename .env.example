# Copiar a .env y completar. NUNCA subir .env al repo.
POSTGRES_DB=bodegas
POSTGRES_USER=bodegas_owner
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_PORT=5432

# Rol con privilegios minimos que usa la API (se crea en 007_roles.sql)
API_DB_USER=bodegas_api
API_DB_PASSWORD=cambiar_esta_clave
DATABASE_URL=postgresql://bodegas_api:cambiar_esta_clave@db:5432/bodegas
